#include "messages.h"
#include "minishell.h"
#include "cmd.h"

static void	handle_loop(t_shell *shell)
{
	char	*input;
	char	**args;
	(void)args;
	(void)shell;
	t_lexer_token_def	*lexer_token_def;
	
	lexer_token_def = get_lexer_token_def();
	printf("masks: %u\n", lexer_token_def->masks.metachar);

	while (TRUE)
	{
		input = readline(SHELL_NAME);
		if (!input)
			break ;
		if (*input)
			command_handler(input, shell);
		free(input);
		printf("exit code: %d\n", shell->exit_code);
	}
}

int	main(int argc, char **argv, char **envp)
{
	const char	*exit_args[] = {"exit", NULL};
	t_shell		shell;

	(void)argc;
	(void)argv;
	shell = init_shell(envp);
	init_signals();
	handle_loop(&shell);
	ft_exit(&shell, (char **)exit_args);
	return (0);
}

